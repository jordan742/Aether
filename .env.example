# ── Alpaca Paper Trading ──────────────────────────────────────────────────────
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ── Sentinel-2 / Copernicus Open Access Hub ───────────────────────────────────
# Leave blank to run in simulation mode (no real imagery fetched).
SENTINEL_USER=your_copernicus_username_here
SENTINEL_PASSWORD=your_copernicus_password_here

# ── Orbital Gateway ───────────────────────────────────────────────────────────
# Port / maritime chokepoint to monitor.
# Options: strait_of_gibraltar | strait_of_hormuz | singapore_strait | english_channel
ORBITAL_PORT=strait_of_gibraltar

# How often (seconds) the orbital gateway writes a fresh telemetry snapshot.
TELEMETRY_INTERVAL=60

# ── Circuit Breaker ───────────────────────────────────────────────────────────
# Daily loss threshold as a decimal (0.02 = 2 %).
CIRCUIT_BREAKER_THRESHOLD=0.02
